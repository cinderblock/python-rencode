{
  "name": "python-rencode",
  "version": "2.0.0",
  "description": "Arbitrary data encoder/decoder that matches python rencode (the format used by Deluge's RPC API).",
  "type": "module",
  "main": "dist/rencode.js",
  "types": "dist/rencode.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rencode.d.ts",
      "default": "./dist/rencode.js"
    }
  },
  "files": [
    "dist/rencode.js",
    "dist/rencode.js.map",
    "dist/rencode.d.ts",
    "dist/rencode.d.ts.map"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test src",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/python-rencode.git"
  },
  "keywords": [
    "serialization",
    "serialize",
    "bencode",
    "rencode",
    "python-rencode",
    "deluge",
    "bittorrent"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/python-rencode/issues"
  },
  "homepage": "https://github.com/cinderblock/python-rencode#readme",
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.19.19",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3"
  }
}
